<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sfi.scaffold</groupId>
        <artifactId>scaffold-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.sfi.matrix</groupId>
    <artifactId>matrix</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>matrix</name>
    <description>总聚合根：单仓阶段一次性构建。每个顶层模块 = 未来一个独立 git 仓库，各自根 pom 自包含可独立构建。</description>

    <!--
      按最终仓库边界聚合：每个顶层模块 = 未来一个独立 git 仓库。
      - matrix-platform → 平台仓（被复用的基础能力：iam + support）
      将来加公墓/寄存等独立系统，新增顶层目录 + 这里加一行 module。
      拆仓时：把顶层文件夹整个拷到新仓库即可，其根 pom 已自包含版本声明。
    -->
    <modules>
        <module>matrix-platform</module>
    </modules>
</project>
