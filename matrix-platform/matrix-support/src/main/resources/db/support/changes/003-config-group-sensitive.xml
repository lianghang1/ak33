<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- 参数支持分组（多 key 配置，如微信支付一组）与敏感标记（选择性存储加密） -->

    <changeSet id="support-003-config-group" author="matrix">
        <addColumn tableName="sys_config">
            <column name="config_group" type="VARCHAR(64)" defaultValue="DEFAULT"
                    remarks="配置分组，如 wechat.pay；默认 DEFAULT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="sys_config">
            <column name="sensitive" type="BOOLEAN" defaultValueBoolean="false"
                    remarks="是否敏感值（写入加密落库、读取解密返回）">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 密文为 Base64（膨胀约 1.4 倍）+ 分组场景可能存较长 JSON，放宽列长 -->
    <changeSet id="support-003-config-value-length" author="matrix">
        <modifyDataType tableName="sys_config" columnName="config_value" newDataType="VARCHAR(2048)"/>
    </changeSet>

    <!-- 唯一键从 (tenant_id, config_key) 调整为 (tenant_id, config_group, config_key, deleted) -->
    <changeSet id="support-003-config-unique" author="matrix">
        <dropUniqueConstraint tableName="sys_config" constraintName="uk_sys_config_key"/>
        <addUniqueConstraint tableName="sys_config"
                             columnNames="tenant_id, config_group, config_key, deleted"
                             constraintName="uk_sys_config_group_key"/>
    </changeSet>

</databaseChangeLog>
