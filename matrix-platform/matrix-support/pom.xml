<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sfi.matrix.platform</groupId>
        <artifactId>matrix-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>matrix-support</artifactId>
    <name>matrix-support</name>
    <description>轻量通用能力收容：数据字典 dict、系统参数 config。单表小功能按包扩展，不建新模块。</description>

    <dependencies>
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-query</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-tenant</artifactId>
        </dependency>
        <!-- 字典/参数读多写少：两级缓存（Caffeine L1 + Redis L2） -->
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-cache</artifactId>
        </dependency>
        <!-- 平台默认配置兜底：查 PLATFORM 租户 ID（iam 不反向依赖 support，无环） -->
        <dependency>
            <groupId>com.sfi.matrix.platform</groupId>
            <artifactId>matrix-iam</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ===== 测试 ===== -->
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-redis</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
