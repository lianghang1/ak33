<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- ============ 平台全局表（无 tenant_id，不参与租户过滤） ============ -->

    <changeSet id="20261121-01" author="lianghang">
        <createTable tableName="sys_tenant" remarks="租户">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="tenant_code" type="VARCHAR(64)" remarks="租户编码"><constraints nullable="false"/></column>
            <column name="tenant_name" type="VARCHAR(128)" remarks="租户名称"><constraints nullable="false"/></column>
            <column name="package_id" type="BIGINT" remarks="开通的套餐ID"/>
            <column name="expire_time" type="DATE" remarks="到期日"/>
            <column name="status" type="INT" defaultValueNumeric="1" remarks="1启用 0停用"><constraints nullable="false"/></column>
            <column name="remark" type="VARCHAR(255)"/>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_tenant" columnNames="tenant_code" constraintName="uk_sys_tenant_code"/>
    </changeSet>

    <changeSet id="20261121-02" author="lianghang">
        <createTable tableName="sys_tenant_package" remarks="租户套餐（平台全局）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="package_code" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="package_name" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="remark" type="VARCHAR(255)"/>
            <column name="status" type="INT" defaultValueNumeric="1"><constraints nullable="false"/></column>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_tenant_package" columnNames="package_code" constraintName="uk_sys_package_code"/>
    </changeSet>

    <changeSet id="20261121-03" author="lianghang">
        <createTable tableName="sys_package_menu" remarks="套餐-菜单关联（平台全局）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="package_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="menu_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_package_menu" columnNames="package_id, menu_id" constraintName="uk_sys_package_menu"/>
    </changeSet>

    <changeSet id="20261121-04" author="lianghang">
        <createTable tableName="sys_menu" remarks="菜单/权限点（平台全局定义）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="menu_name" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="menu_type" type="VARCHAR(2)" remarks="M目录 C菜单 F按钮"><constraints nullable="false"/></column>
            <column name="menu_scope" type="VARCHAR(16)" defaultValue="TENANT" remarks="PLATFORM运营平台/TENANT租户业务/COMMON通用"><constraints nullable="false"/></column>
            <column name="parent_id" type="BIGINT"/>
            <column name="path" type="VARCHAR(128)"/>
            <column name="component" type="VARCHAR(128)"/>
            <column name="icon" type="VARCHAR(64)"/>
            <column name="permission" type="VARCHAR(128)" remarks="权限标识"/>
            <column name="api_pattern" type="VARCHAR(512)" remarks="URL权限模式，Ant风格，多个逗号分隔，如 /api/iam/user/**,/api/iam/tenant/**"/>
            <column name="sort_no" type="INT"/>
            <column name="visible" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <!-- ============ 账号主体（无 tenant_id） ============ -->

    <changeSet id="20261121-05" author="lianghang">
        <createTable tableName="sys_user" remarks="系统用户账号主体（只存登录鉴权核心字段，username 全局唯一）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="account_type" type="VARCHAR(16)" defaultValue="OPERATOR" remarks="账号类型:OPERATOR/APP/MEMBER"><constraints nullable="false"/></column>
            <column name="username" type="VARCHAR(64)" remarks="登录账号"><constraints nullable="false"/></column>
            <column name="password" type="VARCHAR(128)" remarks="密码(BCrypt)"><constraints nullable="false"/></column>
            <column name="mobile" type="VARCHAR(32)"/>
            <column name="email" type="VARCHAR(128)"/>
            <column name="status" type="INT" defaultValueNumeric="1" remarks="1启用 0禁用"><constraints nullable="false"/></column>
            <column name="max_sessions" type="INT" remarks="该账号最大在线会话数；null 跟随全局默认"/>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_user" columnNames="username" constraintName="uk_sys_user_name"/>
    </changeSet>

    <!-- ============ 用户资料（1:1）与社交绑定（1:N） ============ -->

    <changeSet id="20261121-06" author="lianghang">
        <createTable tableName="sys_user_profile" remarks="用户资料（1:1，展示/业务用，不参与登录）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="user_id" type="BIGINT" remarks="对应 sys_user.id"><constraints nullable="false"/></column>
            <column name="nickname" type="VARCHAR(64)"/>
            <column name="avatar" type="VARCHAR(255)"/>
            <column name="sex" type="INT" defaultValueNumeric="0" remarks="0未知 1男 2女"/>
            <column name="birthday" type="VARCHAR(10)"/>
            <column name="id_card" type="VARCHAR(32)" remarks="身份证号"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="remark" type="VARCHAR(500)"/>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_user_profile" columnNames="user_id" constraintName="uk_profile_user"/>

        <createTable tableName="sys_user_social" remarks="用户社交绑定（1:N，只存绑定关系与第三方标识）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="user_id" type="BIGINT" remarks="对应 sys_user.id"><constraints nullable="false"/></column>
            <column name="provider" type="VARCHAR(32)" remarks="平台:wechat-mp/wechat-mini/alipay"><constraints nullable="false"/></column>
            <column name="open_id" type="VARCHAR(64)" remarks="平台内主标识 openId"><constraints nullable="false"/></column>
            <column name="union_id" type="VARCHAR(64)" remarks="跨应用统一标识 unionId（可空）"/>
            <column name="ext_info" type="VARCHAR(2000)" remarks="第三方原始返回快照 JSON"/>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_user_social" columnNames="provider, open_id" constraintName="uk_social_provider_open"/>
        <createIndex tableName="sys_user_social" indexName="idx_social_union">
            <column name="provider"/>
            <column name="union_id"/>
        </createIndex>
    </changeSet>

    <!-- ============ 租户隔离表（有 tenant_id + @Filter） ============ -->

    <changeSet id="20261121-07" author="lianghang">
        <createTable tableName="sys_user_tenant" remarks="用户-租户归属（不标租户过滤，登录跨租户查）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="tenant_id" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="dept_id" type="BIGINT" remarks="该账号在此租户下的部门"/>
            <column name="status" type="INT" defaultValueNumeric="1" remarks="1启用 0停用"><constraints nullable="false"/></column>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_user_tenant" columnNames="user_id, tenant_id" constraintName="uk_sys_user_tenant"/>
        <createIndex tableName="sys_user_tenant" indexName="idx_sys_user_tenant_tid">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261121-08" author="lianghang">
        <createTable tableName="sys_dept" remarks="部门（租户内组织结构）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="VARCHAR(64)"/>
            <column name="dept_name" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="parent_id" type="BIGINT"/>
            <column name="sort_no" type="INT"/>
            <column name="leader_id" type="BIGINT"/>
            <column name="status" type="INT" defaultValueNumeric="1"><constraints nullable="false"/></column>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="sys_dept" indexName="idx_sys_dept_tid">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261121-09" author="lianghang">
        <createTable tableName="sys_role" remarks="系统角色（租户内）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="VARCHAR(64)"/>
            <column name="role_code" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="role_name" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="role_type" type="VARCHAR(32)" defaultValue="NORMAL" remarks="PLATFORM_ADMIN/TENANT_ADMIN/NORMAL"><constraints nullable="false"/></column>
            <column name="sort_no" type="INT"/>
            <column name="status" type="INT" defaultValueNumeric="1" remarks="1启用 0停用"><constraints nullable="false"/></column>
            <column name="built_in" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="data_scope" type="VARCHAR(32)" defaultValue="ALL" remarks="数据范围:ALL/DEPT_CUSTOM/DEPT_ONLY/DEPT_AND_CHILD/SELF"><constraints nullable="false"/></column>
            <column name="data_scope_dept_ids" type="VARCHAR(255)" remarks="指定部门(DEPT_CUSTOM用),逗号分隔部门ID"/>
            <column name="remark" type="VARCHAR(255)"/>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_role" columnNames="tenant_id, role_code" constraintName="uk_sys_role_code"/>
        <createIndex tableName="sys_role" indexName="idx_sys_role_tid">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261121-10" author="lianghang">
        <createTable tableName="sys_user_role" remarks="用户-角色关联（租户内）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="VARCHAR(64)"/>
            <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="role_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_user_role" columnNames="tenant_id, user_id, role_id" constraintName="uk_sys_user_role"/>
        <createIndex tableName="sys_user_role" indexName="idx_sys_user_role_tid">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261121-11" author="lianghang">
        <createTable tableName="sys_role_menu" remarks="角色-菜单关联（租户内，菜单为全局定义）">
            <column name="id" type="BIGINT"><constraints primaryKey="true"/></column>
            <column name="tenant_id" type="VARCHAR(64)"/>
            <column name="role_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="menu_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="sys_role_menu" columnNames="tenant_id, role_id, menu_id" constraintName="uk_sys_role_menu"/>
        <createIndex tableName="sys_role_menu" indexName="idx_sys_role_menu_tid">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <!-- ============ 审计日志 ============ -->

    <changeSet id="20261121-12" author="lianghang">
        <createTable tableName="sys_login_log" remarks="登录审计日志">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="username" type="VARCHAR(64)"/>
            <column name="user_id" type="BIGINT" remarks="登录成功的账号ID，失败时为空"/>
            <column name="auth_type" type="VARCHAR(32)"/>
            <column name="tenant_code" type="VARCHAR(64)"/>
            <column name="ip" type="VARCHAR(64)"/>
            <column name="login_location" type="VARCHAR(128)" remarks="IP属地：国家|区域|省|市|ISP"/>
            <column name="user_agent" type="VARCHAR(512)"/>
            <column name="browser" type="VARCHAR(64)" remarks="User-Agent 解析出的浏览器"/>
            <column name="os" type="VARCHAR(64)" remarks="User-Agent 解析出的操作系统"/>
            <column name="source" type="VARCHAR(64)" remarks="登录来源/接入端类型：internal/online/app:{accountNo}"/>
            <column name="device_id" type="VARCHAR(128)" remarks="物理设备标识，来自 X-Device-Id 头"/>
            <column name="success" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="reason_code" type="VARCHAR(64)" remarks="失败原因码：全局业务码枚举名或具体码；成功为 SUCCESS"/>
            <column name="reason" type="VARCHAR(255)"/>
            <column name="params" type="VARCHAR(1000)" remarks="登录入参摘要，密码/授权码等敏感值已剔除"/>
            <column name="trace_id" type="VARCHAR(64)" remarks="链路追踪ID，串联同一次请求的所有日志"/>
            <column name="cost_ms" type="BIGINT" remarks="登录校验耗时（毫秒）"/>
            <column name="login_time" type="DATETIME"/>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="sys_login_log" indexName="idx_login_log_user">
            <column name="username"/>
        </createIndex>
        <createIndex tableName="sys_login_log" indexName="idx_login_log_time">
            <column name="login_time"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261121-13" author="lianghang">
        <createTable tableName="sys_operate_log" remarks="操作审计日志">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="VARCHAR(64)"/>
            <column name="module" type="VARCHAR(64)"/>
            <column name="operation" type="VARCHAR(128)"/>
            <column name="method" type="VARCHAR(255)"/>
            <column name="uri" type="VARCHAR(512)"/>
            <column name="ip" type="VARCHAR(64)"/>
            <column name="oper_user_id" type="BIGINT"/>
            <column name="oper_user_name" type="VARCHAR(64)"/>
            <column name="params" type="VARCHAR(2000)"/>
            <column name="success" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="error_msg" type="VARCHAR(500)"/>
            <column name="cost_ms" type="BIGINT"/>
            <column name="oper_time" type="DATETIME"/>
            <column name="create_time" type="DATETIME"><constraints nullable="false"/></column>
            <column name="update_time" type="DATETIME"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="sys_operate_log" indexName="idx_operate_log_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="sys_operate_log" indexName="idx_operate_log_time">
            <column name="oper_time"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
