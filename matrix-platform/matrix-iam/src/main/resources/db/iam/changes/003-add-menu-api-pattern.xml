<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- URL 权限：菜单/权限点增加 api_pattern，声明该权限点守护的后端 URL（Ant 风格，多个用逗号分隔） -->
    <changeSet id="20261122-01" author="matrix">
        <addColumn tableName="sys_menu">
            <column name="api_pattern" type="VARCHAR(512)" remarks="URL权限模式，Ant风格，多个逗号分隔，如 /api/iam/user/**,/api/iam/tenant/**"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
