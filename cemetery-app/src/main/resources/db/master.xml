<?xml version="1.0" encoding="UTF-8"?>
<!--
  公墓 app 主 changelog：扫描统一目录，聚合所有依赖模块自带的建表脚本。
  各模块脚本放在各自 resources 的 db/changelog/ 下，打包后 classpath 合并为同一目录，
  本文件用 includeAll 一次扫全；新增模块只需把脚本放进该目录，本文件永不改动。
  脚本间须保持无跨模块依赖；同模块内靠 001/002 序号保证有序。
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <includeAll path="db/changelog/" errorIfMissingOrEmpty="true"/>

</databaseChangeLog>
