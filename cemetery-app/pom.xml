<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sfi.scaffold</groupId>
        <artifactId>scaffold-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.sfi.matrix</groupId>
    <artifactId>cemetery-app</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>cemetery-app</name>
    <description>公墓系统宿主：可独立部署的 boot app。按需组装 matrix-iam + matrix-support，公墓业务后续在此扩展。自包含版本声明，可独立拆仓构建。</description>

    <dependencies>
        <!-- ===== 平台能力：按仓库边界依赖，版本由各仓根 pom 管理 ===== -->
        <dependency>
            <groupId>com.sfi.matrix.platform</groupId>
            <artifactId>matrix-iam</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.sfi.matrix.platform</groupId>
            <artifactId>matrix-support</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!--
          token 会话运行期强依赖 Redis（验证码/登录失败锁定/token 存储）。
          iam/support 中 redis 是 test scope，不会传递，宿主必须显式引入。
        -->
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-redis</artifactId>
        </dependency>
        <!-- Liquibase 自动装配 + 建表执行 -->
        <dependency>
            <groupId>com.sfi.scaffold</groupId>
            <artifactId>scaffold-starter-liquibase</artifactId>
        </dependency>

        <!-- 数据库驱动：版本由 spring-boot-dependencies BOM 管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 端到端测试用内存库（H2）；生产走 mysql driver -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
